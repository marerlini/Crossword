<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<GridPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
          fx:controller="org.example.view.MainMenuView"
          alignment="CENTER_LEFT" hgap="20" vgap="10">

   <columnConstraints>
      <ColumnConstraints hgrow="SOMETIMES" percentWidth="50.0"/>
      <ColumnConstraints hgrow="SOMETIMES" percentWidth="50.0"/>
   </columnConstraints>

   <rowConstraints>
      <RowConstraints minHeight="10.0" vgrow="ALWAYS"/>
   </rowConstraints>

   <padding>
      <Insets top="20" right="20" bottom="20" left="20"/>
   </padding>

   <VBox spacing="10" GridPane.columnIndex="0">
      <ComboBox fx:id="themeComboBox"
                promptText="Оберіть тему для редагування або генерації"
                maxWidth="Infinity"/>

      <TextField fx:id="wordField"
                 promptText="Введіть слово"
                 maxWidth="Infinity"/>

      <TextField fx:id="hintField"
                 promptText="Введіть підказку"
                 maxWidth="Infinity"/>

      <Button fx:id="addButton"
              onAction="#onAddWord"
              text="Додати слово"
              maxWidth="Infinity"/>

      <ListView fx:id="wordList" maxWidth="Infinity" VBox.vgrow="ALWAYS"/>
   </VBox>

   <VBox alignment="CENTER" spacing="15" GridPane.columnIndex="1">
      <Button onAction="#onCreateTheme"
              text="Створити нову тему"
              maxWidth="Infinity"/>

      <Region VBox.vgrow="ALWAYS"/>

      <HBox alignment="CENTER" spacing="10">
         <Label text="Кількість слів:" style="-fx-font-size: 16;"/>

         <TextField fx:id="wordCountField"
                    text="0"
                    alignment="CENTER"
                    prefWidth="80"
                    style="-fx-font-size: 18; -fx-font-weight: bold; -fx-background-color: #f0f0f0;"
                    promptText="Кількість"/>
      </HBox>

      <Region VBox.vgrow="ALWAYS"/>

      <Button onAction="#onGenerate"
              style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 18;"
              text="Згенерувати кросворд"
              maxWidth="Infinity"/>
   </VBox>
</GridPane>