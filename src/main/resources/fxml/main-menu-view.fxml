<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.Region?>

<GridPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
          fx:controller="org.example.MainMenuView"
          alignment="CENTER_LEFT" hgap="20" vgap="10">

   <columnConstraints>
      <ColumnConstraints hgrow="SOMETIMES" percentWidth="50.0" />
      <ColumnConstraints hgrow="SOMETIMES" percentWidth="50.0" />
   </columnConstraints>

   <rowConstraints>
      <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="ALWAYS" />
   </rowConstraints>

   <children>
      <VBox spacing="10" GridPane.columnIndex="0">
         <children>
            <ComboBox fx:id="themeComboBox" promptText="Обрати тему" maxWidth="Infinity" />
            <TextField fx:id="wordField" promptText="Введіть слово" text="Слово" maxWidth="Infinity" />
            <TextField fx:id="hintField" promptText="Введіть підказку" text="Підказка" maxWidth="Infinity" />

            <ListView maxWidth="Infinity" VBox.vgrow="ALWAYS" />
         </children>
      </VBox>

      <VBox alignment="CENTER" GridPane.columnIndex="1">
         <children>
            <Button onAction="#onCreateTheme" text="Створити тему" maxWidth="Infinity" />

            <Region VBox.vgrow="ALWAYS" />

            <HBox alignment="CENTER" spacing="10">
               <children>
                  <Label text="Кількість слів:" />
                  <Label fx:id="wordCountLabel" text="3" />
               </children>
            </HBox>

            <Region VBox.vgrow="ALWAYS" />

            <Button alignment="BOTTOM_CENTER" onAction="#onGenerate"
                    style="-fx-font-size: 16;" text="Згенерувати" maxWidth="Infinity" />
         </children>
      </VBox>
   </children>

   <padding>
      <Insets top="20" right="20" bottom="20" left="20" />
   </padding>
</GridPane>