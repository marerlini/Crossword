<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.ScrollPane?>

<GridPane alignment="CENTER_LEFT" hgap="20" vgap="10"
          xmlns="http://javafx.com/javafx/17.0.2"
          xmlns:fx="http://javafx.com/fxml/1"
          fx:controller="org.example.view.CrosswordResultView">

    <columnConstraints>
        <ColumnConstraints hgrow="SOMETIMES" percentWidth="50.0"/>
        <ColumnConstraints hgrow="SOMETIMES" percentWidth="50.0"/>
    </columnConstraints>

    <rowConstraints>
        <RowConstraints minHeight="10.0" vgrow="ALWAYS"/>
    </rowConstraints>

    <padding>
        <Insets bottom="20" left="20" right="20" top="20"/>
    </padding>
    <VBox spacing="15" GridPane.columnIndex="0">
        <ScrollPane fx:id="crosswordScrollPane"
                    pannable="true"
                    VBox.vgrow="ALWAYS"
                    prefHeight="600"
                    maxHeight="800"
                    minHeight="400"
                    style="-fx-background: white; -fx-border-color: #aaa; -fx-border-width: 2;">
            <GridPane fx:id="crosswordGridPane"
                      alignment="CENTER"
                      hgap="2" vgap="2"
                      style="-fx-background-color: white;"/>
        </ScrollPane>

        <TextArea fx:id="hintsArea"
                  editable="false"
                  wrapText="true"
                  prefHeight="300"
                  minHeight="200"
                  maxHeight="500"
                  promptText="Тут будуть підказки..."
                  style="-fx-font-size: 14px;"
                  VBox.vgrow="ALWAYS"/>
    </VBox>

    <VBox alignment="CENTER" GridPane.columnIndex="1">
        <Button onAction="#onBack"
                maxWidth="Infinity"
                style="-fx-background-color: #ccc;"
                text="Назад"/>

        <Region VBox.vgrow="ALWAYS"/>

        <Button fx:id="showAnswerButton"
                maxWidth="Infinity"
                text="Показати відповіді"
                onAction="#toggleAnswers"/>

        <Region VBox.vgrow="ALWAYS"/>

        <Button maxWidth="Infinity"
                text="Перегенерувати"
                onAction="#regenerateCrossword"/>

        <Region VBox.vgrow="ALWAYS"/>

        <Button maxWidth="Infinity"
                text="Зберегти як PDF"
                onAction="#saveAsPdf"
                style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold;"/>
    </VBox>
</GridPane>